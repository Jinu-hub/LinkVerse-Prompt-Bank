{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "summary_short": {
      "type": "string",
      "description": "Concise high-priority summary paragraph"
    },
    "summary_structured": {
      "type": "object",
      "description": "Structured prose summary for readability",
      "properties": {
        "core_message": {
          "type": "string",
          "description": "Most important single message"
        },
        "what_happened": {
          "type": "string",
          "description": "Main factual flow of events"
        },
        "why_it_matters": {
          "type": "string",
          "description": "Reader/market relevance"
        },
        "supporting_points": {
          "type": "string",
          "description": "Decision-relevant support only"
        },
        "risks_and_constraints": {
          "type": "string",
          "description": "Uncertainty, downside, and constraints framing"
        }
      },
      "required": [
        "core_message",
        "what_happened",
        "why_it_matters",
        "supporting_points",
        "risks_and_constraints"
      ]
    },
    "key_takeaways": {
      "type": "array",
      "description": "Self-contained high-signal one-sentence takeaways",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["summary_short", "summary_structured", "key_takeaways"]
}
