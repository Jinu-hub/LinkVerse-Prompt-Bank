{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "required": [
    "input_date",
    "topic",
    "claims",
    "evidence",
    "risks",
    "assumptions"
  ],
  "properties": {
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "type"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "topic": {
      "type": "string",
      "description": "Topic or title of the digest"
    },
    "claims": {
      "type": "object",
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "type"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "type"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "linked_claim",
          "type",
          "strength"
        ],
        "properties": {
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string"
          },
          "strength": {
            "type": "string"
          },
          "linked_claim": {
            "type": "string",
            "pattern": "^(primary|secondary)_[1-9][0-9]*$"
          }
        }
      }
    },
    "input_date": {
      "type": "string",
      "description": "Anchor date of the digest (e.g. YYYY-MM-DD)"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "type"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    }
  }
}