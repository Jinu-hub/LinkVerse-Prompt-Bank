{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "input_date": {
      "type": "string",
      "description": "Anchor date of the digest (YYYY-MM-DD)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "summary": {
      "type": "string",
      "description": "Overall editorial summary of the digest"
    },
    "highlights": {
      "type": "array",
      "description": "Pre-selected highlight items with written copy",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "why_it_matters": { "type": "string" }
        },
        "required": ["title", "summary", "why_it_matters"]
      }
    },
    "items": {
      "type": "array",
      "description": "Regular items with short news-brief summaries",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "summary": { "type": "string" }
        },
        "required": ["title", "summary"]
      }
    },
    "more_items": {
      "type": "array",
      "description": "Additional brief items that contain summary only",
      "items": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" }
        },
        "required": ["summary"]
      }
    },
    "ending": {
      "type": "string",
      "description": "Closing paragraph of the digest"
    }
  },
  "required": ["input_date", "summary", "highlights", "items", "more_items", "ending"]
}
