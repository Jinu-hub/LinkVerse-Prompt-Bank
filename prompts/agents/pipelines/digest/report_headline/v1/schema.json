{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "output": {
      "type": "string",
      "description": "Exactly one Markdown headline line in the form: '## <headline>'",
      "pattern": "^##\\s+\\S[\\s\\S]*$"
    }
  },
  "required": ["output"],
  "additionalProperties": false
}
