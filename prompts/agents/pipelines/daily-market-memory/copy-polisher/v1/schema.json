{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "copy-polisher-v1-output",
  "description": "Polished dashboard memory row array (same item shape as daily-market-memory-data output rows). Only polishable text fields may change between input and output.",
  "type": "array",
  "minItems": 3,
  "maxItems": 3,
  "items": {
    "$ref": "#/definitions/row"
  },
  "definitions": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lang_code": {
          "type": "string",
          "enum": ["ko", "en", "ja"],
          "description": "Locked: copied exactly from input."
        },
        "display_title": {
          "type": "string",
          "minLength": 1,
          "description": "Polishable: short dashboard headline."
        },
        "display_subtitle": {
          "type": "string",
          "minLength": 1,
          "description": "Polishable: compact subtitle."
        },
        "core_summary": {
          "type": "string",
          "minLength": 1,
          "description": "Polishable: 2 to 4 concise dashboard sentences."
        },
        "top_themes": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/definitions/theme"
          },
          "description": "Same length and order as input; only theme_title and summary are polishable per item."
        },
        "market_mood_label": {
          "type": "string",
          "minLength": 1,
          "description": "Polishable: localized primary mood headline."
        },
        "market_mood_type": {
          "type": "string",
          "enum": ["Risk-On", "Risk-Off", "Mixed", "Cautious"],
          "description": "Locked: copied exactly from input."
        },
        "market_mood_bias": {
          "type": "string",
          "enum": ["risk_on", "neutral", "risk_off"],
          "description": "Locked: copied exactly from input."
        },
        "market_mood_shift": {
          "type": "string",
          "enum": ["improving", "stable", "deteriorating", "unavailable"],
          "description": "Locked: copied exactly from input."
        },
        "market_mood_shift_label": {
          "type": "string",
          "description": "Polishable: localized short phrase for shift; may be empty when shift is unavailable."
        },
        "market_mood_summary": {
          "type": "string",
          "minLength": 1,
          "description": "Polishable: 1 to 2 sentences explaining risk tone."
        }
      },
      "required": [
        "lang_code",
        "display_title",
        "display_subtitle",
        "core_summary",
        "top_themes",
        "market_mood_label",
        "market_mood_type",
        "market_mood_bias",
        "market_mood_shift",
        "market_mood_shift_label",
        "market_mood_summary"
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme_title": {
          "type": "string",
          "minLength": 1,
          "description": "Polishable: localized short card title."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "Polishable: concise theme explanation."
        },
        "signal_strength": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Locked: copied exactly from input."
        },
        "signal_strength_label": {
          "type": "string",
          "minLength": 1,
          "description": "Locked: copied exactly from input."
        },
        "related_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Locked: copied exactly from input."
        },
        "related_report_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Locked: copied exactly from input."
        },
        "source_report_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Locked: copied exactly from input."
        },
        "source_item_content_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Locked: copied exactly from input."
        }
      },
      "required": [
        "theme_title",
        "summary",
        "signal_strength",
        "signal_strength_label",
        "related_tags",
        "related_report_count",
        "source_report_ids",
        "source_item_content_ids"
      ]
    }
  }
}
