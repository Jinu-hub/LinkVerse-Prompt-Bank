{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ThesisSummarizerOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary_structured": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thesis": { "type": "string" },
        "why_now": { "type": "string" },
        "key_mechanism": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 4
        },
        "beneficiary_groups": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sector": { "type": "string" },
              "reason": { "type": "string" },
              "companies": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["sector", "reason", "companies"]
          }
        },
        "case_study": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "meaning": { "type": "string" }
          },
          "required": ["name", "meaning"]
        },
        "investor_implication": { "type": "string" },
        "risks": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 3,
          "maxItems": 5
        }
      },
      "required": [
        "thesis",
        "why_now",
        "key_mechanism",
        "beneficiary_groups",
        "case_study",
        "investor_implication",
        "risks"
      ]
    },
    "key_takeaways": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 4,
      "maxItems": 6
    },
    "summary_short": { "type": "string" }
  },
  "required": [
    "summary_structured",
    "key_takeaways",
    "summary_short"
  ]
}
